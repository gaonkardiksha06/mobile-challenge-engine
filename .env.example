# Copy to .env at the repo root and fill in your values.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# .env is gitignored — never commit real secrets.

# Required for AI review (15% of challenge score).
# Get a key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: local dashboard port (default: 7700)
# DASHBOARD_PORT=7700

# Optional: learner repo URL for npm run setup (avoids interactive prompt)
# SETUP_ORIGIN_URL=https://github.com/your-username/your-fork.git
